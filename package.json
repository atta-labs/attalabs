{
  "name": "atta-ai",
  "private": true,
  "packageManager": "bun@1.2.14",
  "workspaces": [
    "apps/attalabs/mcp-server",
    "apps/attalabs/mobile",
    "apps/attalabs/web",
    "apps/herald-ai/mcp",
    "apps/herald-ai/mcp-server",
    "apps/herald-ai/mobile",
    "apps/herald-ai/web",
    "apps/vada-ai/mcp-server",
    "apps/vada-ai/mobile",
    "apps/vada-ai/web",
    "apps/vinaya-portal/web",
    "apps/vinaya-studio/web",
    "packages/adapter-langgraph",
    "packages/agents/forensic-hiring-auditor",
    "packages/agents/vada-deliberation",
    "packages/agents/vada-fusion",
    "packages/agents/vada-fusion-native",
    "packages/atta-agents",
    "packages/auth",
    "packages/cms",
    "packages/crypto",
    "packages/db",
    "packages/engine",
    "packages/executor-agent-spawn",
    "packages/identity",
    "packages/instrumentation",
    "packages/models",
    "packages/storage",
    "packages/typescript-config",
    "packages/ui",
    "tools/admin"
  ],
  "scripts": {
    "validate:ui-contract": "node scripts/validate-ui-contract.mjs",
    "dev": "node scripts/validate-ui-contract.mjs && turbo dev",
    "dev:herald": "node scripts/validate-ui-contract.mjs && turbo dev --filter=@atta/herald-ai-web",
    "dev:vada": "node scripts/validate-ui-contract.mjs && turbo dev --filter=@atta/vada-ai-web",
    "dev:attalabs": "node scripts/validate-ui-contract.mjs && turbo dev --filter=@atta/attalabs-web",
    "dev:vinaya-portal": "node scripts/validate-ui-contract.mjs && turbo dev --filter=@atta/vinaya-portal-web",
    "dev:vinaya-studio": "node scripts/validate-ui-contract.mjs && turbo dev --filter=@atta/vinaya-studio-web",
    "dev:admin": "turbo dev --filter=@atta/admin",
    "build": "node scripts/validate-ui-contract.mjs && turbo build",
    "build:herald": "node scripts/validate-ui-contract.mjs && turbo build --filter=@atta/herald-ai-web",
    "build:vada": "node scripts/validate-ui-contract.mjs && turbo build --filter=@atta/vada-ai-web",
    "build:attalabs": "node scripts/validate-ui-contract.mjs && turbo build --filter=@atta/attalabs-web",
    "build:vinaya-portal": "node scripts/validate-ui-contract.mjs && turbo build --filter=@atta/vinaya-portal-web",
    "build:vinaya-studio": "node scripts/validate-ui-contract.mjs && turbo build --filter=@atta/vinaya-studio-web",
    "typecheck": "turbo typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format .",
    "format:fix": "biome format --fix .",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check --fix .",
    "check": "turbo typecheck && biome check . && turbo test --affected && bun scripts/check-forbidden-colors.ts",
    "test": "turbo test",
    "docs:index": "node scripts/generate-docs-index.mjs",
    "verify-docs": "bash scripts/verify-docs.sh",
    "db": "bash scripts/db-studio.sh",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "overrides": {
    "next": "16.2.12"
  },
  "devDependencies": {
    "@attalabs/aeg-core": "^0.24.1",
    "@attalabs/vinaya": "0.24.1",
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
