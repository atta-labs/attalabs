# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
out/
dist/
build/
**/.turbo/
docs/
# Re-include AEG docs renderer (aeg-core).
!packages/aeg-core/src/docs/
!packages/aeg-core/src/docs/**
# Re-include Vinaya Studio's docs redirect stubs (vinaya-studio-v1 task 1
# addendum; the live route itself moved to (site)/docs below, vinaya-pages-v1
# task 8, #568).
!apps/vinaya/web/src/app/studio/docs/
!apps/vinaya/web/src/app/studio/docs/**
# Re-include Vinaya's live docs route, moved from studio/docs/ to the (site)
# Portal route group (vinaya-pages-v1 task 8, #568).
!apps/vinaya/web/src/app/(site)/docs/
!apps/vinaya/web/src/app/(site)/docs/**
!apps/vinaya/web/src/lib/docs/
!apps/vinaya/web/src/lib/docs/**

