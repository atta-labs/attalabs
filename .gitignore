# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
out/
dist/
build/
**/.turbo/
docs/
# Re-include for the Portal app (vinaya-portal-studio-split-v1
# task 1, #883). Without it the whole docs route group and its loaders are
# silently untracked — the app builds locally off working-tree files and the
# commit ships a Portal with no /docs at all.
!apps/vinaya-portal/web/src/app/(site)/docs/
!apps/vinaya-portal/web/src/app/(site)/docs/**
!apps/vinaya-portal/web/src/lib/docs/
!apps/vinaya-portal/web/src/lib/docs/**

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

