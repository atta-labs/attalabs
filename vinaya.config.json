{
  "checks": {
    "attalabs/vocabulary-citation": {
      "run": "./scripts/vinaya-checks/vocabulary-citation.ts",
      "scope": "full",
      "timeoutMs": 30000
    },
    "attalabs/task-anchor": {
      "run": "./scripts/vinaya-checks/task-anchor.ts",
      "scope": "full",
      "timeoutMs": 30000
    }
  },
  "ci": {
    "setup": "npm install -g bun && bun install --frozen-lockfile --ignore-scripts"
  },
  "briefSchema": {
    "pr": {
      "sections": [
        {
          "builtin": "tier"
        },
        {
          "builtin": "testPlan"
        },
        {
          "builtin": "testPlanExclusivity"
        },
        {
          "builtin": "principalPlaceholder"
        },
        {
          "builtin": "surfaceMap"
        },
        {
          "builtin": "docUpdateList"
        },
        {
          "builtin": "worktreeStep0"
        },
        {
          "builtin": "stopConditions"
        },
        {
          "builtin": "autonomyClause"
        },
        {
          "builtin": "project"
        },
        {
          "builtin": "for"
        },
        {
          "builtin": "closesN"
        },
        {
          "builtin": "premiseCoverage"
        }
      ]
    },
    "issue": {
      "sections": [
        {
          "builtin": "issueRationale"
        },
        {
          "builtin": "project"
        }
      ]
    }
  },
  "managed": {
    "version": 2,
    "files": [
      ".github/workflows/vinaya-checks.yml",
      ".github/workflows/vinaya-review.yml",
      ".github/workflows/vinaya-review-verdict.yml",
      ".github/workflows/vinaya-archivist.yml",
      ".github/workflows/vinaya-body-checks.yml",
      "VINAYA.md",
      "vinaya/checks/.gitkeep",
      "vinaya/roles/.gitkeep",
      ".agents/skills/vinaya-architect/SKILL.md",
      ".agents/skills/vinaya-archivist/SKILL.md",
      ".agents/skills/vinaya-brief-author/SKILL.md",
      ".agents/skills/vinaya-developer/SKILL.md",
      ".agents/skills/vinaya-planner/SKILL.md",
      ".agents/skills/vinaya-reviewer/SKILL.md",
      ".agents/skills/vinaya-security/SKILL.md",
      ".agents/skills/vinaya-tranche-archivist/SKILL.md",
      ".claude/commands/vinaya.md",
      ".gemini/commands/vinaya.toml"
    ],
    "blocks": [
      {
        "path": ".husky/pre-commit",
        "marker": "pre-commit",
        "comment": "hash"
      },
      {
        "path": ".husky/pre-push",
        "marker": "pre-push",
        "comment": "hash"
      },
      {
        "path": ".claude/hooks/track-transcript.sh",
        "marker": "track-transcript",
        "comment": "hash"
      }
    ],
    "labels": ["vinaya/blocked", "vinaya/override:docs", "vinaya/direct-main-push", "vinaya/dead-branch-push"],
    "agents": ["claude", "gemini", "skills"]
  }
}
