{
  "checks": {
    "attalabs/vocabulary-citation": {
      "run": "./scripts/vinaya-checks/vocabulary-citation.ts",
      "scope": "full",
      "timeoutMs": 30000,
      "env": {
        "BASE_SHA": {
          "optional": true
        }
      }
    },
    "attalabs/task-anchor": {
      "run": "./scripts/vinaya-checks/task-anchor.ts",
      "scope": "full",
      "timeoutMs": 30000,
      "env": {
        "BASE_SHA": {
          "optional": true
        }
      }
    },
    "atta-labs/secret-scan": {
      "run": "./scripts/vinaya-checks/secret-scan.ts",
      "scope": "full"
    }
  },
  "reviewPolicy": {
    "codeReviewThreshold": "MAJOR",
    "securityThreshold": "HIGH",
    "maxRounds": 7
  },
  "principals": [
    "daniboomerang"
  ],
  "projects": [
    {
      "name": "admin",
      "path": "tools/admin"
    },
    {
      "name": "vada",
      "path": "apps/vada-ai"
    },
    {
      "name": "herald",
      "path": "apps/herald-ai"
    },
    {
      "name": "engine",
      "path": "packages/engine"
    },
    {
      "name": "adapter",
      "path": "packages/adapter-langgraph"
    },
    {
      "name": "executor-agent-spawn",
      "path": "packages/executor-agent-spawn"
    },
    {
      "name": "agents",
      "path": "packages/agents"
    },
    {
      "name": "ui",
      "path": "packages/ui"
    },
    {
      "name": "attalabs",
      "path": "apps/attalabs"
    },
    {
      "name": "vinaya"
    },
    {
      "name": "vinaya-portal",
      "path": "apps/vinaya-portal"
    },
    {
      "name": "vinaya-studio",
      "path": "apps/vinaya-studio"
    }
  ],
  "ci": {
    "setup": "set -euo pipefail\nnpm install -g bun@1.4.2 && bun install --frozen-lockfile --ignore-scripts\nGITLEAKS_VERSION=8.30.1\nGITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb\ncurl -fsSL -o /tmp/gitleaks.tar.gz \"https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz\"\necho \"${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz\" | sha256sum -c -\nsudo tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks\nsudo chmod +x /usr/local/bin/gitleaks\ngitleaks version"
  },
  "briefSchema": {
    "pr": {
      "sections": [
        {
          "builtin": "tier"
        },
        {
          "builtin": "testPlan"
        },
        {
          "builtin": "testPlanExclusivity"
        },
        {
          "builtin": "closesN"
        },
        {
          "builtin": "project"
        }
      ]
    },
    "issue": {
      "sections": [
        {
          "builtin": "issueRationale"
        },
        {
          "builtin": "objectives"
        },
        {
          "builtin": "briefSections"
        },
        {
          "builtin": "project"
        }
      ]
    }
  },
  "managed": {
    "version": 3,
    "files": [
      ".github/workflows/vinaya-checks.yml",
      ".github/workflows/vinaya-review.yml",
      ".github/workflows/vinaya-review-verdict.yml",
      ".github/workflows/vinaya-archivist.yml",
      ".github/workflows/vinaya-body-checks.yml",
      "VINAYA.md",
      "vinaya/checks/.gitkeep",
      "vinaya/roles/.gitkeep",
      ".agents/skills/vinaya-architect/SKILL.md",
      ".agents/skills/vinaya-archivist/SKILL.md",
      ".agents/skills/vinaya-developer/SKILL.md",
      ".agents/skills/vinaya-operator/SKILL.md",
      ".agents/skills/vinaya-planner/SKILL.md",
      ".agents/skills/vinaya-reviewer/SKILL.md",
      ".agents/skills/vinaya-security/SKILL.md",
      ".agents/skills/vinaya-tranche-archivist/SKILL.md",
      ".claude/commands/vinaya.md",
      ".mcp.json",
      ".gemini/commands/vinaya.toml"
    ],
    "blocks": [
      {
        "path": ".husky/pre-commit",
        "marker": "pre-commit",
        "comment": "hash"
      },
      {
        "path": ".husky/pre-push",
        "marker": "pre-push",
        "comment": "hash"
      },
      {
        "path": ".husky/commit-msg",
        "marker": "commit-msg",
        "comment": "hash"
      },
      {
        "path": ".claude/hooks/track-transcript.sh",
        "marker": "track-transcript",
        "comment": "hash"
      }
    ],
    "labels": [
      "vinaya/backlog",
      "vinaya/type:build",
      "vinaya/type:chore",
      "vinaya/type:docs",
      "vinaya/type:perf",
      "vinaya/type:refactor",
      "vinaya/type:revert",
      "vinaya/type:style",
      "vinaya/type:test"
    ],
    "agents": [
      "claude",
      "gemini",
      "skills"
    ]
  }
}
