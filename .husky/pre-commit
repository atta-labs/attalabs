# Refuse commits made directly on `main`. AEG requires every repo-file change to
# land on main via a worktree branch + PR + green merge — never a direct commit.
# Gate on the current branch being main; all other branches fall through to the
# existing checks. (This is ring-0 prevention: it refuses the commit before the
# bad artifact exists, which the forge-side ruleset can only reject after the
# fact.)
if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ]; then
  echo "✖ pre-commit: direct commits to main are forbidden." >&2
  echo "  AEG routes every change to main through a worktree branch + PR + green merge." >&2
  echo "  Create a worktree branch (git worktree add … -b task/<tranche>/<n> origin/main) and commit there." >&2
  exit 1
fi

bun run check

