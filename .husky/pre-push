# Reject any push whose target is `main`. AEG requires every repo-file change to
# reach main via a worktree branch + PR + green merge — never a direct push.
# Branch protection is unavailable on this private+free repo, so this guard lives
# in the hook. Gate on the PUSH TARGET being main, not on "is a worktree" — a
# legitimate push of a task branch to origin must always pass.
#
# git feeds pre-push one line per ref on stdin: `<localref> <localsha> <remoteref> <remotesha>`.
while read -r _localref _localsha remoteref _remotesha; do
  if [ "$remoteref" = "refs/heads/main" ]; then
    echo "✖ pre-push: direct pushes to main are forbidden." >&2
    echo "  AEG routes every change to main through a worktree branch + PR + green merge." >&2
    echo "  Push your task/<iteration>/<n> branch and open a PR instead." >&2
    exit 1
  fi

  # D-073/D-078: a task/<iteration>/<id> branch may only be pushed when its
  # <id> literal-matches a row in aeg-root/iterations/<iteration>.md's `#`
  # column. Catches wrong-branch-name pushes (the T-prefix epidemic) at the
  # earliest possible moment instead of leaving them to die at PR-open.
  branch="${remoteref#refs/heads/}"
  case "$branch" in
    task/*/*)
      iter=$(printf '%s' "$branch" | cut -d/ -f2)
      id=$(printf '%s' "$branch" | cut -d/ -f3)
      topo="aeg-root/iterations/${iter}.md"
      if [ ! -f "$topo" ]; then
        echo "✖ pre-push: branch \`$branch\` names iteration \`$iter\`, but $topo does not exist." >&2
        echo "  A task branch must belong to a real iteration (D-073/D-075)." >&2
        exit 1
      fi
      if ! grep -qE "^\|[[:space:]]*${id}[[:space:]]*\|" "$topo"; then
        echo "✖ pre-push: branch \`$branch\` — no row with \`#\` = \`${id}\` in $topo." >&2
        echo "  The branch suffix must literal-match the topology's # column (D-073)." >&2
        echo "  If the plan PR adding this row hasn't merged yet, merge it first (D-075)." >&2
        exit 1
      fi
      ;;
  esac

  # D-078: doc-owners coverage (C5) on the branch's CUMULATIVE diff vs
  # origin/main — bound code cannot be published without its bound doc in the
  # same branch. Catches the follow-up-push window that the PR-creation gate
  # (open-pr.ts) cannot see. If the branch already has an open PR, its body
  # supplies Doc-ack/Doc-waiver lines; on the first push there is no PR yet
  # and the check is strict (the wrapper re-validates at PR-open anyway).
  pr_body=$(gh pr view "$branch" --json body -q .body 2>/dev/null || true)
  if ! PR_BODY="$pr_body" bun packages/aeg-core/bin/verify-docs.ts --push; then
    echo "✖ pre-push: doc-owners coverage failed for \`$branch\` (output above)." >&2
    echo "  Bound code changed without its bound doc — update the doc (or add a" >&2
    echo "  Doc-waiver line to the open PR's body) and push again (D-078)." >&2
    exit 1
  fi
done
