{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "check": {
      "dependsOn": ["typecheck"]
    },
    "build": {
      "dependsOn": ["typecheck", "^build"],
      "env": [
        "DATABASE_URL",
        "CLERK_SECRET_KEY",
        "ANTHROPIC_API_KEY",
        "SETTINGS_ENCRYPTION_KEY",
        "GROQ_API_KEY",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "DEFAULT_PROVIDER",
        "VADA_USE_LANGGRAPH",
        "VADA_DAILY_SESSION_LIMIT"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false,
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["generate", "^typecheck"]
    },
    "clean": {
      "cache": false
    }
  }
}
