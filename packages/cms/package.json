{
  "name": "@atta/cms",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./utils/oklch": "./src/utils/oklch.ts"
  },
  "scripts": {
    "studio": "sanity dev --port 3333",
    "studio:atta": "SANITY_STUDIO_PRODUCT=atta sanity dev --port 3334",
    "studio:vada": "SANITY_STUDIO_PRODUCT=vada sanity dev --port 3335",
    "studio:vitakka": "SANITY_STUDIO_PRODUCT=vitakka sanity dev --port 3336",
    "studio:deploy": "sanity deploy",
    "studio:deploy:atta": "SANITY_STUDIO_PRODUCT=atta sanity deploy",
    "studio:deploy:vada": "SANITY_STUDIO_PRODUCT=vada sanity deploy",
    "studio:deploy:vitakka": "SANITY_STUDIO_PRODUCT=vitakka sanity deploy",
    "studio:deploy:all": "bun run studio:deploy -- -y && bun run studio:deploy:atta -- -y && bun run studio:deploy:vada -- -y && bun run studio:deploy:vitakka -- -y",
    "seed:branding": "bun run ./scripts/seed-branding.ts",
    "seed:branding:atta": "SANITY_PROJECT_ID=892o2m9f SANITY_SEED_PRODUCT=atta bun run ./scripts/seed-branding.ts",
    "seed:branding:vada": "SANITY_PROJECT_ID=ofnj2ojb SANITY_SEED_PRODUCT=vada bun run ./scripts/seed-branding.ts",
    "seed:branding:vitakka": "SANITY_PROJECT_ID=o56nzgrr SANITY_SEED_PRODUCT=vitakka bun run ./scripts/seed-branding.ts",
    "seed:branding:herald": "SANITY_PROJECT_ID=e9gbd2d1 SANITY_SEED_PRODUCT=herald bun run ./scripts/seed-branding.ts",
    "migrate:herald-to-product": "bun run ./scripts/migrate-herald-to-product.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@atta/typescript-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@sanity/client": "^7.20.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/ui": "^3.1.13",
    "@sanity/vision": "^5.19.0",
    "culori": "^4.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sanity": "^5.19.0",
    "styled-components": "^6.1.15"
  }
}
