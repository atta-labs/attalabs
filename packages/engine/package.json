{
  "name": "@atta/engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external --sourcemap=none",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@atta/agents": "workspace:*",
    "js-yaml": "^4.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@atta/typescript-config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
