{
  "name": "@atta/executor-agent-spawn",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external --sourcemap=none",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:external-consumer": "bun run scripts/verify-external-consumer.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@atta/engine": "workspace:*",
    "@langchain/langgraph": "^0.2.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@atta/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  }
}
